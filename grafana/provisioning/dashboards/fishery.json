          "rawQuery": true,
          "rawSql": "SELECT CONCAT(r.name, ' - ', d.name) AS metric, d.status\nFROM dashboard_device d\nJOIN dashboard_room r ON d.room_id = r.id\nWHERE d.type IN ('fish_aerator', 'fish_feeder', 'fish_heater')\n  AND r.category = 'fish'\nORDER BY r.name, d.name",
